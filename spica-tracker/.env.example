# Переменные окружения Spica Tracker (шаблон для Beget / Docker)
# Скопируйте в .env и заполните реальные значения.

# ВНИМАНИЕ: Для Docker на Beget замените 'db' на реальное имя сервиса БД из docker-compose.yml (например, 'db' или 'postgres'), либо на внешний хост Beget Cloud DB. Не используйте localhost!
DATABASE_URL="postgresql://spica:PASSWORD@db:5432/spica"

JWT_SECRET="change-me"
