generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Пользователи (руководитель, исполнители, клиенты)
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          String   // ADMIN | EXECUTOR | CLIENT
  specialization String? // SALARY | TAX | DOCS | null
  createdAt     DateTime @default(now())

  assignedTasks    Task[]      @relation("TaskAssignee")
  executorTasks    Task[]      @relation("TaskExecutor")
  createdTasks     Task[]      @relation("TaskCreator")
  comments         Comment[]
  documents        Document[]
  primaryClients   Client[]    @relation("PrimaryExecutor")
  secondaryClients Client[]    @relation("SecondaryExecutor")
  assignmentRules  AssignmentRule[]
  clientCompany    Client?
  articles         Article[]
  favorites        Favorite[]
}

// Клиенты (компании)
model Client {
  id                  String   @id @default(cuid())
  name                String
  taxSystem           String   // OSNO | USN | USN15 | AUSN8 | AUSN20 | PSN | ESHN | PATENT
  legalForm           String?  // ООО | ИП | АО | ...
  shortName           String?  // краткое название
  salaryPaymentDay    Int?     // день месяца выплаты зарплаты
  advanceDay          Int?     // день месяца выплаты аванса
  employeeCount       Int?     // кол-во сотрудников
  invoiceDay          Int?     // день выписки счёта
  invoiceAmount       Float?   // сумма счёта (в карточке клиента)
  paymentPeriod       String   @default("MONTH") // MONTH | QUARTER — оплата за месяц или за квартал
  accountNote         String?  // расч. счёт (присылает или авто) — текст
  features            String?  // особенности клиента (свободный текст)
  hasCashRegister     Boolean  @default(false) // касса есть
  salaryViaCash       Boolean  @default(false) // зарплата выдаётся через кассу
  primaryExecutorId   String
  secondaryExecutorId String?
  clientUserId        String?  @unique
  createdAt           DateTime @default(now())

  primaryExecutor   User    @relation("PrimaryExecutor", fields: [primaryExecutorId], references: [id])
  secondaryExecutor User?   @relation("SecondaryExecutor", fields: [secondaryExecutorId], references: [id])
  clientUser        User?   @relation(fields: [clientUserId], references: [id])
  tasks             Task[]
  assignmentRules   AssignmentRule[]
  monthBalances     MonthBalance[]
}

// Правила авто-распределения задач
model AssignmentRule {
  id        String @id @default(cuid())
  clientId  String
  taskType  String
  executorId String

  client   Client @relation(fields: [clientId], references: [id])
  executor User   @relation(fields: [executorId], references: [id])

  @@unique([clientId, taskType])
}

// Задачи
model Task {
  id                 String    @id @default(cuid())
  title              String
  clientId           String
  taskType           String    // SALARY_* | TAX_PAYMENT | REPORT | REPORT_* (виды сроков: НДС/прибыль/6-НДФЛ/НДФЛ/УСН/транспорт/имущество/взносы/РСВ/ЕФС-1/ПСФ/АУСН) | IFNS_DEMAND | DEMAND_RECEIPT | CLIENT_REQUEST | OTHER
  status             String    @default("NEW") // NEW | IN_PROGRESS | DONE | SENT_TO_CLIENT | REWORK | OVERDUE
  assignedToId       String
  executorId         String?
  createdById        String
  deadline           DateTime?
  receiptDeadline    DateTime?
  salaryCalcDate     DateTime?
  salaryPaymentDate  DateTime?
  taxAmount          Float?
  taxPaymentDate     DateTime?
  amount             Float?   // сумма для задач «Счёт» / «Оплата счёта»
  isClientNotified   Boolean   @default(false)
  urgent             Boolean   @default(false)
  durationMinutes    Int?      // план (минуты)
  factDurationMinutes Int?     // факт (минуты)
  docCount           Int?      // количество первичных документов (ввод на бух. программу)
  startTime          String?   // время переноса в «Ежедневник у сотрудников» (ЧЧ:ММ)
  endTime            String?   // время переноса на «Выполнено» (ЧЧ:ММ)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  archivedAt         DateTime? // null — активная; не null — в архиве
  completedAt        DateTime? // дата выполнения (переход в DONE, для таблицы отчётности)
  knowledgeArticleId String?   // ссылка на статью базы знаний

  client     Client     @relation(fields: [clientId], references: [id])
  assignedTo User       @relation("TaskAssignee", fields: [assignedToId], references: [id])
  executor   User?      @relation("TaskExecutor", fields: [executorId], references: [id])
  createdBy  User       @relation("TaskCreator", fields: [createdById], references: [id])
  knowledgeArticle Article? @relation(fields: [knowledgeArticleId], references: [id], onDelete: SetNull)
  comments   Comment[]
  documents  Document[]
}

// Начальные остатки и оплаты на месяц (вносятся вручную на вкладке «Оплаты»)
model MonthBalance {
  id            String  @id @default(cuid())
  clientId      String
  month         String  // "YYYY-MM"
  startBalance  Float   @default(0)
  startManual   Boolean @default(false) // старт введён вручную; иначе переносится с прошлого месяца
  paymentAmount Float   @default(0)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, month])
}

// Комментарии к задачам
model Comment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  text      String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

// Документы
model Document {
  id          String   @id @default(cuid())
  taskId      String
  uploadedById String
  fileName    String
  fileUrl     String
  category    String   @default("OTHER") // PRIMARY | CERTIFICATE | OTHER
  createdAt   DateTime @default(now())

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id])
}

// Раздел общей базы знаний
model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  icon      String   @default("📄")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  articles Article[]
}

// Материал базы знаний (текст или ссылка)
model Article {
  id         String   @id @default(cuid())
  categoryId String
  type       String   @default("text") // text | link
  title      String
  content    String?  // Markdown-текст (для type=text)
  url        String?  // внешняя ссылка (для type=link)
  tags       String[] @default([])
  isPinned   Boolean  @default(false)
  authorId   String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category  Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  author    User       @relation(fields: [authorId], references: [id])
  favorites Favorite[]
  tasks     Task[]
}

// Избранное пользователя (⭐ в базе знаний)
model Favorite {
  userId    String
  articleId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
}
